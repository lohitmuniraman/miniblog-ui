{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    // --- CRITICAL FOR PATHS ---
    "baseUrl": "./src", // This sets the base directory for path resolution
    "paths": {
      // Each alias should map to an array of possible paths
      // These paths are RELATIVE TO THE BASEURL (./src)
      "@components/*": ["components/*"],
      "@pages/*": ["pages/*"],
      "@services/*": ["services/*"],
      "@utils/*": ["utils/*"],
      "@type/*": ["types/*"],
      "@config/*": ["config/*"],
      "@contexts/*": ["contexts/*"],
      "@hooks/*": ["hooks/*"],
      "@layouts/*": ["layouts/*"],
      "@styles/*": ["styles/*"],
      "@assets/*": ["assets/*"]
    }
  },
  // --- CRITICAL FOR TYPESCRIPT TO PROCESS YOUR FILES ---
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite-env.d.ts"], // Ensure all your source files are covered
  "exclude": ["node_modules", "dist"], // Good practice to exclude these
  "references": [{ "path": "./tsconfig.node.json" }]
}